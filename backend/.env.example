# Local development outside Docker. docker-compose.yml sets these for containers.
DATABASE_URL=postgresql://admin:admin123@localhost:5433/face_recognition
QDRANT_HOST=localhost
QDRANT_PORT=6333

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

ADMIN_EMAIL=admin@facerecognition.pro
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
MATCH_THRESHOLD=0.70
FACE_LOGIN_THRESHOLD=0.78

MEDIA_DIR=./media
